      "description": "Owner-issued staff invitations mapping verified Google emails to roles"
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Wholesale product catalog and warehouse inventory counts"
    },
    "/stock_batches/{batchId}": {
      "schema": { "$ref": "#/entities/StockBatch" },
      "description": "Purchase-lot batches for actual batch purchase cost tracking"
    },
    "/suppliers/{supplierId}": {
      "schema": { "$ref": "#/entities/Supplier" },
      "description": "Supplier master profiles and payable totals"
    },
    "/shops/{shopId}": {
      "schema": { "$ref": "#/entities/Shop" },
      "description": "Retail shop customer profiles across Paschim Medinipur"
    },
    "/purchases/{purchaseId}": {
      "schema": { "$ref": "#/entities/Purchase" },
      "description": "Warehouse and direct-to-shop purchase orders"
    },
    "/purchase_items/{itemId}": {
      "schema": { "$ref": "#/entities/PurchaseItem" },
      "description": "Line items for purchase transactions"
    },
    "/sales/{saleId}": {
      "schema": { "$ref": "#/entities/Sale" },
      "description": "Warehouse dispatch and direct supplier dispatch sales/deliveries"
    },
    "/sale_items/{itemId}": {
      "schema": { "$ref": "#/entities/SaleItem" },
      "description": "Line items for sales and delivery invoices"
