        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdByName": { "type": "string", "minLength": 1, "maxLength": 100 }
      },
      "required": ["returnNumber", "returnType", "returnDate", "partyType", "productId", "productName", "qty", "unitValue", "totalValue", "condition", "returnedToStock", "reason", "status", "orgId", "isDemo", "createdAt", "updatedAt", "createdBy", "createdByName"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable activity and transaction audit log",
      "type": "object",
      "properties": {
        "action": { "type": "string", "minLength": 1, "maxLength": 80 },
        "module": { "type": "string", "minLength": 1, "maxLength": 60 },
        "entityId": { "type": "string", "maxLength": 128 },
        "entityLabel": { "type": "string", "maxLength": 160 },
        "details": { "type": "string", "minLength": 1, "maxLength": 500 },
        "oldValue": { "type": "string", "maxLength": 500 },
        "newValue": { "type": "string", "maxLength": 500 },
        "notes": { "type": "string", "maxLength": 500 },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "userName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "userRole": { "type": "string", "minLength": 1, "maxLength": 32 },
        "orgId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "isDemo": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["action", "module", "details", "userId", "userName", "userRole", "orgId", "isDemo", "createdAt"]
    },
    "AppSettings": {
      "title": "AppSettings",
      "description": "System and business configuration settings",
      "type": "object",
      "properties": {
        "businessName": { "type": "string", "minLength": 1, "maxLength": 160 },
        "appName": { "type": "string", "minLength": 1, "maxLength": 160 },
        "location": { "type": "string", "minLength": 1, "maxLength": 240 },
        "phone": { "type": "string", "maxLength": 24 },
        "gstin": { "type": "string", "maxLength": 20 },
        "logoUrl": { "type": "string", "maxLength": 80000 },
        "invoicePrefix": { "type": "string", "minLength": 1, "maxLength": 20 },
        "invoiceSequence": { "type": "number" },
        "defaultPrintFormat": { "type": "string", "enum": ["a4", "a5", "80mm", "58mm"] },
        "defaultLowStockThreshold": { "type": "number" },
        "allowNegativeStock": { "type": "boolean" },
        "lastBackupAt": { "type": "string", "maxLength": 64 },
        "orgId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string", "minLength": 1, "maxLength": 128 }
      },
      "required": ["businessName", "appName", "location", "invoicePrefix", "allowNegativeStock", "orgId", "updatedAt", "updatedBy"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Authenticated user profiles and RBAC roles"
    },
    "/staff_invites/{inviteId}": {
